########################################
# Authentication
########################################
# Shared password for all test users
# User emails are defined in src/config/users.js (version-controlled)
GENERAL_PASSWORD=

########################################
# Application Configuration
########################################
# Base URL of the application under test
AUTOMATION_APP_BASEURL=

# Run browser in headless mode
# - "true" for CI/CD environments
# - "false" for local debugging
AUTOMATION_HEADLESS=

# Default timeout for operations in milliseconds
AUTOMATION_TIMEOUT_MS=

########################################
# Browser & Debug Settings
########################################
# Browser type: chromium | firefox | webkit
AUTOMATION_BROWSER_TYPE=

# Enable Playwright tracing for debugging
AUTOMATION_ENABLE_TRACING=

# Capture screenshots on failure
AUTOMATION_CAPTURE_SCREENSHOTS=

# Slow motion delay in ms (useful for debugging)
AUTOMATION_SLOW_MO=

########################################
# Test Artifacts
########################################
# Directory for storing test results and artifacts
AUTOMATION_ARTIFACTS_DIR=

########################################
# Azure Storage (Payload Validation)
########################################
# Connection string for the Azure Storage account that holds the AmadeusLogEntity table
# and xml{MMyyyy} blob containers (request/response payloads).
# Example accounts: datastorageproduction, atriistmc2staging2
AZURE_STORAGE_CONNECTION_STRING=

# How far back (in minutes) to search for matching table entries (default: 60)
AZURE_STORAGE_LOOKBACK_MINUTES=60

# Timeout for Azure Storage SDK operations in milliseconds (default: 30000)
AZURE_STORAGE_TIMEOUT_MS=30000