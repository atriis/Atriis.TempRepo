# Base URL of the application under test
AUTOMATION_APP_BASEURL=

# Base URL of the legacy GTP back office (AngularJS) that agents use to work requested trips.
# Only agent-assistance scenarios navigate here.
LEGACY_GTP_BASEURL=

# General password for authentication (shared across all test users)
GENERAL_PASSWORD=
 
########################################
# Application Configuration
########################################
 
# Run browser in headless mode
# - "true" for CI/CD environments
# - "false" for local debugging
AUTOMATION_HEADLESS=
 
# Default timeout for operations in milliseconds
AUTOMATION_TIMEOUT_MS=
 
########################################
# Browser & Debug Settings
########################################
# Browser type: chromium | firefox | webkit
AUTOMATION_BROWSER_TYPE=
 
# Enable Playwright tracing for debugging
AUTOMATION_ENABLE_TRACING=
 
# Capture screenshots on failure
AUTOMATION_CAPTURE_SCREENSHOTS=
 
# Slow motion delay in ms (useful for debugging)
AUTOMATION_SLOW_MO=
 
########################################
# Test Artifacts
########################################
# Directory for storing test results and artifacts
AUTOMATION_ARTIFACTS_DIR=
 
########################################
# Internal API (Payload Validation)
########################################
PAYLOAD_VALIDATION_INTERNAL_ATRIIS_BASE_URL=
PAYLOAD_VALIDATION_INTERNAL_ATRIIS_TOKEN=
 
# Enable/disable payload validation steps globally.
# Accepted values: true/false, 1/0, yes/no, on/off (default: true)
PAYLOAD_VALIDATION_ENABLED=true
 
# How far back (in minutes) to search for matching table entries (default: 60)
PAYLOAD_VALIDATION_LOOKBACK_MINUTES=
 
# Timeout for Payload Validation API operations in milliseconds (default: 20000)
PAYLOAD_VALIDATION_TIMEOUT_MS=
 
# Maximum number of request-type matches to scan in fallback mode (default: 20)
PAYLOAD_VALIDATION_MAX_REQUESTS_MATCHES=

########################################
# DB Queries (Azure SQL) — see docs/DbQueries.md
########################################
# Enable/disable DB query steps globally.
# Accepted values: true/false, 1/0, yes/no, on/off (default: true)
DB_QUERIES_ENABLED=true

# Azure SQL server host and database, e.g. myserver.database.windows.net
DB_SERVER_NAME=
DB_DATABASE_NAME=

# entra-mfa (local, interactive sign-in) | service-principal (CI) | azure-cli (az login / azure/login OIDC)
DB_AUTHENTICATION=

# entra-mfa: your UPN, used as the sign-in hint
DB_USER_NAME=

# service-principal: app registration credentials (DB_TENANT_ID is optional for entra-mfa)
DB_TENANT_ID=
DB_CLIENT_ID=
DB_CLIENT_SECRET=

# Request and connection timeout in milliseconds (default: 30000)
DB_TIMEOUT_MS=

########################################
# Known Booking Errors (Optional)
########################################
# Optional JSON object merged together with src/config/knownBookingErrors.json.
# Arrays are combined, so JSON arrays + env are both used.
# Set this to true only when you want env arrays to replace JSON arrays.
KNOWN_BOOKING_ERRORS_OVERRIDE_JSON=
# Example:
# KNOWN_BOOKING_ERRORS_JSON={"flights":{"knownErrors":["Error details as received from the supplier:","Custom supplier error"],"skipOnError":true}}
KNOWN_BOOKING_ERRORS_JSON=
 
########################################
# Share Quote / Itinerary Emails
########################################
# Fallback domain for the addresses generated when a test shares a quote or itinerary to an
# external recipient. Used only when no test mailbox is configured below (default:
# example.com, which is RFC 2606 reserved and never routes, so the mail is unreadable).
SHARE_RECIPIENT_EMAIL_DOMAIN=
 
# Test mailbox (Mailsac) used to read the emails the app actually sends, so a scenario can
# assert on delivered mail and not only on the in-app preview. Leave MAILBOX_API_KEY empty to
# switch mail reading off — steps that read mail then fail with a configuration error, they
# never pass vacuously.
#
# The key comes from the Mailsac dashboard -> API Keys & Users. It is shown ONCE on creation,
# so save it then; losing it means regenerating. The free plan meters operations — received mail
# AND API calls — per month.
MAILBOX_API_KEY=

# Domain the generated addresses are created under. Empty means mailsac.com.
MAILBOX_DOMAIN=

# The RESERVED (private) Mailsac address every share is delivered to. Strongly preferred over
# leaving this empty, which falls back to a freshly generated PUBLIC address per scenario:
#   - public mailsac.com inboxes are world-readable by anyone who guesses the name, and
#   - an account with "Allow Public Domains" off cannot read them at all. That combination is
#     silent: the API answers 200 with an empty list, so delivered mail looks like mail that
#     never arrived.
# Reserve one in the dashboard (Private Addresses; the free tier includes one) and switch
# "Capture Private" on, or the mail is never stored. Messages are deleted once read, so the
# inbox does not accumulate against the account's message limit.
#
# Because one inbox is then shared by every scenario and by every parallel worker, the mailbox
# read is narrowed by the shared trip number rather than by the address — see
# tests/steps/email.steps.js.
MAILBOX_ADDRESS=
 
# How long to wait for a sent email to land, and the gap between polls.
# Code defaults are 120000 / 5000. Each poll is one metered API call, so raising the interval
# is the lever for spending fewer calls per scenario.
MAILBOX_TIMEOUT_MS=120000
MAILBOX_POLL_INTERVAL_MS=15000
