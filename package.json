{
  "name": "atriisautomation-playwright",
  "version": "1.0.0",
  "description": "Playwright end-to-end automation framework",
  "scripts": {
    "env:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-env-from-1password.ps1",
    "payload:check": "node scripts/check-payload-api.js",
    "db:check": "node scripts/check-db.js",
    "db:query": "node scripts/run-db-query.js",
    "test:unit": "node scripts/run-unit-tests.js",
    "bdd:db": "npx cucumber-js tests/features/db/",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:dev:headed": "cross-env TEST_ENV=dev playwright test --headed",
    "test:staging": "playwright test",
    "test:staging:headed": "playwright test --headed",
    "test:default": "playwright test --grep='@supplier:default' --project='*:default'",
    "test:all": "playwright test --grep='@supplier:all'",
    "test:gds": "playwright test --grep='@supplier:gds' --project='*:gds:*'",
    "test:ndc": "playwright test --grep='@supplier:ndc' --project='*:ndc:*'",
    "test:comprehensive": "playwright test --grep='@supplier:all|@priority:critical'",
    "bdd": "cucumber-js",
    "bdd:rerun": "npx cucumber-js @test-results/rerun.txt --config cucumber.js",
    "bdd:rerun:headed": "cross-env HEADLESS=false npx cucumber-js @test-results/rerun.txt --config cucumber.js",
    "bdd:smoke": "npx cucumber-js tests/features/smoke/",
    "bdd:flights:general": "npx cucumber-js tests/features/flights/",
    "bdd:flights:lufthansa": "npx cucumber-js tests/features/flights/lufthansa/",
    "bdd:hotels:general": "npx cucumber-js tests/features/hotels/",
    "bdd:hotels:galileo": "npx cucumber-js tests/features/hotels/galileo/",
    "bdd:cars:general": "npx cucumber-js tests/features/transportation/cars/amadeus/ tests/features/transportation/cars/galileo/ tests/features/transportation/cars/general/ tests/features/transportation/cars/sabre/ tests/features/transportation/cars/sunny_cars/*.feature",
    "bdd:cars:galileo": "npx cucumber-js tests/features/transportation/cars/galileo/",
    "bdd:rails:benerail": "npx cucumber-js tests/features/transportation/rails/benerail/*.feature",
    "bdd:manual_quote": "npx cucumber-js tests/features/manual_quote/"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e"
  ],
  "author": "ATRIIS Automation Team",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@cucumber/gherkin-streams": "6.0.0",
    "@cucumber/messages": "31.2.0",
    "@cucumber/pretty-formatter": "^2.4.1",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.40.0",
    "allure": "^3.3.1",
    "allure-cucumberjs": "^3.6.0",
    "allure-js-commons": "^3.6.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^10.0.0",
    "module-alias": "^2.2.3",
    "playwright-trx-reporter": "^1.0.10",
    "pptxgenjs": "^4.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "_moduleAliases": {
    "@src": "src",
    "@pages": "src/pages",
    "@dsl": "src/dsl",
    "@data": "src/data",
    "@utils": "src/utils",
    "@config": "src/config",
    "@fixtures": "tests/fixtures"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "4.13.1",
    "@azure/storage-blob": "^12.31.0",
    "mssql": "^12.7.2"
  },
  "overrides": {
    "tedious": "19.2.2",
    "@azure/core-rest-pipeline": "1.24.0",
    "@azure-rest/core-client": "2.7.0",
    "@typespec/ts-http-runtime": "0.3.6"
  }
}
