{
  "name": "atriisautomation-playwright",
  "version": "1.0.0",
  "description": "Playwright end-to-end automation framework",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:dev:headed": "cross-env TEST_ENV=dev playwright test --headed",
    "test:staging": "playwright test",
    "test:staging:headed": "playwright test --headed",
    "test:default": "playwright test --grep='@supplier:default' --project='*:default'",
    "test:all": "playwright test --grep='@supplier:all'",
    "test:gds": "playwright test --grep='@supplier:gds' --project='*:gds:*'",
    "test:ndc": "playwright test --grep='@supplier:ndc' --project='*:ndc:*'",
    "test:comprehensive": "playwright test --grep='@supplier:all|@priority:critical'",
    "bdd": "cucumber-js",
    "bdd:smoke": "set PROVIDER=amadeus && npx cucumber-js tests/features/smoke/",
    "bdd:flights:general": "set PROVIDER=amadeus && npx cucumber-js tests/features/flights/",
    "bdd:flights:lufthansa": "set PROVIDER=lufthansa && npx cucumber-js tests/features/flights/lufthansa/",
    "bdd:hotels:general": "set PROVIDER=ratehawk && npx cucumber-js tests/features/hotels/",
    "bdd:hotels:galileo": "set PROVIDER=galileo && npx cucumber-js tests/features/hotels/galileo/",
    "bdd:cars:general": "npx cucumber-js tests/features/cars/",
    "bdd:cars:galileo": "set PROVIDER=galileo && npx cucumber-js tests/features/cars/galileo/",
    "bdd:manual_quote": "set PROVIDER=amadeus && npx cucumber-js tests/features/manual_quote/",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "report": "node scripts/generate-report.js"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e"
  ],
  "author": "ATRIIS Automation Team",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@cucumber/pretty-formatter": "^2.4.1",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.40.0",
    "allure-commandline": "^2.38.0",
    "allure-cucumberjs": "^3.6.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^10.0.0",
    "module-alias": "^2.2.3",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "playwright-trx-reporter": "^1.0.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "_moduleAliases": {
    "@src": "src",
    "@pages": "src/pages",
    "@dsl": "src/dsl",
    "@data": "src/data",
    "@utils": "src/utils",
    "@config": "src/config",
    "@fixtures": "tests/fixtures"
  }
}
